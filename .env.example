# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for admin tasks (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# Site URL used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Later tracks (leave empty until needed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
